<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Audit-only file access policy for a first pilot: nothing is blocked and no notification is shown; every access a
     rule would deny is uploaded to the sync server as an AUDIT_ONLY file access event. See docs/faa-audit-policy.md. -->
<plist version="1.0">
<dict>
	<key>Version</key>
	<string>audit-pilot-1</string>
	<key>WatchItems</key>
	<dict>
		<!-- Jamf's agent and its support files: writes by anything but Jamf and Apple's installer. VERIFY the Team ID first: codesign -dv /usr/local/jamf/bin/jamf -->
		<key>ProtectJamf</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/usr/local/jamf/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
				<dict>
					<key>Path</key>
					<string>/Library/Application Support/JAMF/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<true/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
			<key>Processes</key>
			<array>
				<dict>
					<key>TeamID</key>
					<string>483DWKW443</string>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.installer</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.installd</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.package-script-service</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
			</array>
		</dict>
		<!-- Launch daemons and agents for every user: persistence installed by anything but an installer or Jamf. -->
		<key>SystemLaunchItems</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/Library/LaunchDaemons/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
				<dict>
					<key>Path</key>
					<string>/Library/LaunchAgents/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<true/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
			<key>Processes</key>
			<array>
				<dict>
					<key>SigningID</key>
					<string>com.apple.installer</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.installd</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.package-script-service</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>TeamID</key>
					<string>483DWKW443</string>
				</dict>
			</array>
		</dict>
		<!-- Per-user launch agents: every write is logged, as there is no list of legitimate writers yet. -->
		<key>UserLaunchAgents</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/Users/*/Library/LaunchAgents/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<true/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
		</dict>
		<!-- Chrome cookies, read by anything but Chrome and Spotlight (North Pole cookbook, audit only). -->
		<key>ChromeCookies</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/Users/*/Library/Application Support/Google/Chrome/*/Cookies</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<false/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
			<key>Processes</key>
			<array>
				<dict>
					<key>SigningID</key>
					<string>com.google.Chrome*</string>
					<key>TeamID</key>
					<string>EQHXZ8M8AV</string>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.mdworker_shared</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.mds</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
			</array>
		</dict>
		<!-- sudoers and sudo timestamps, touched by anything but sudo (North Pole cookbook, audit only). -->
		<key>Sudoers</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/private/etc/sudoers</string>
				</dict>
				<dict>
					<key>Path</key>
					<string>/private/etc/sudoers.d/*</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
				<dict>
					<key>Path</key>
					<string>/private/var/db/sudo/ts/*</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<false/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
			<key>Processes</key>
			<array>
				<dict>
					<key>SigningID</key>
					<string>com.apple.sudo</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
			</array>
		</dict>
		<!-- PAM configuration: every write is logged; macOS updates will show up here too. -->
		<key>PAMConfig</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/private/etc/pam.d/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<true/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
		</dict>
		<!-- SSH keys and configuration, read by anything but the SSH tools. -->
		<key>SSHKeys</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/Users/*/.ssh/</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<false/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
			<key>Processes</key>
			<array>
				<dict>
					<key>SigningID</key>
					<string>com.apple.ssh</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.ssh-agent</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.ssh-add</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.ssh-keygen</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.scp</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.sftp</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
				<dict>
					<key>SigningID</key>
					<string>com.apple.sshd-session</string>
					<key>PlatformBinary</key>
					<true/>
				</dict>
			</array>
		</dict>
		<!-- The temporary file dyld writes when code is loaded from memory through NSCreateObjectFileImageFromMemory; nothing is expected to write it. It does not catch interpreters calling native code directly or custom loaders. -->
		<key>InMemoryCodeLoading</key>
		<dict>
			<key>Paths</key>
			<array>
				<dict>
					<key>Path</key>
					<string>/private/var/folders/*/*/T/NSCreateObjectFileImageFromMemory-</string>
					<key>IsPrefix</key>
					<true/>
				</dict>
			</array>
			<key>Options</key>
			<dict>
				<key>AllowReadAccess</key>
				<false/>
				<key>AuditOnly</key>
				<true/>
				<key>RuleType</key>
				<string>PathsWithAllowedProcesses</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
